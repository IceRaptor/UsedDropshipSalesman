{
    "Name": "UsedDropshipSalesman",
    "Enabled": true,
    "Hidden": true,
    "Version": "0.5.0",
    "Description": "Allows for a progression of dropship types.",
    "Author": "IceRaptor",
    "Website": "https://github.com/IceRaptor/UsedDropshipSalesman",
    "Contact": "",
    "DLL": "UsedDropshipSalesman.dll",
    "DLLEntryPoint" : "UsedDropshipSalesman.Mod.Init",
    "DependsOn" : [ "IRBTModUtils", "Custom Ammo Categories", "CustomUnits", "JwTweaks" ],
    "ConflictsWith" : [ "BiggerDrops" ],
    "CustomResourceTypes": [
        "CustomDropshipDef"
    ],
    "Manifest" : [
        { "Type": "AssetBundle", "Path": "assetbundles" },
        { "Type": "CustomDropshipDef", "Path": "customDropships" },
        { "Type": "ShipModuleUpgrade", "Path": "shipUpgrades" },
        { "Type": "SVGAsset", "Path": "icons" },
        { "Type": "SimGameEventDef", "Path": "events" },
        { "Type": "SimGameStatDescDef", "Path": "simGameStatDesc", "AddToDB": true },
        { "Type": "AdvancedJSONMerge", "Path": "advancedJsonMerges" }
    ],

    "Settings": {
        "Debug" : true,
        "Trace" : true,
        "FallbackDropship" : "union_base",
        "CareerStartDropshipByPlanetName" : {
            "Ichlangis" : "leopard_base",
            "Brinton" : "leopard_tank_variant",
            "Bromhead" : "union_base",
            "Hurik" : "overlord_base",
            "Pilpala" : "argo"

        },
        "Colors" : {
            "Upgrades": {
                "Purchased"             : [ [ 0.253, 1.0, 0.0, 0.5 ],   [ 0.253, 1.0, 0.0, 1.0 ] ],
                "Available"             : [ [ 1.0, 1.0, 1.0, 0.5 ],     [ 1.0, 1.0, 1.0, 1.0 ] ],
                "Unavailable"           : [ [ 1.0, 0.235, 0.0, 0.196 ], [ 1.0, 0.235, 0.0, 0.5 ] ],
                "Innate"                : [ [ 0.0, 0.65, 1.0, 0.5 ],    [ 1.0, 1.0, 1.0, 1.0 ] ]
            }
        },
        "PersistentUpgrades" : [
            "argoUpgrade_medBay1", "argoUpgrade_medBay2", "argoUpgrade_medBay3", "argoUpgrade_medBay_hospital"
        ],
        "LocalizedText" : {
            "FT_IED_DEFAULT" : "Explosive IED",
            "FT_IED_HE" : "High Explosive IED",
            "FT_IED_INFERNO" : "Inferno IED",
            "FT_IED_VBIED" : "Vibration IED",
            "TURRET_DEATH" : "{0} DESTROYED"
        }
    }
}
